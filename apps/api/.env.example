# 本地开发数据库：由 npm run dev 自动拉起的 PGlite（Postgres 18.3 编译成 WASM），
# 数据落在 apps/api/.pgdata，不需要 Docker、也不需要系统里装 Postgres。
# 端口用 5433 而不是 5432，避免和可能还开着的 docker compose 撞端口。
# PGlite 的 socket 服务不做鉴权，用户名密码填什么都能连；库名固定是 postgres。
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?schema=public"
# PGlite 是单会话后端：Prisma 连接池必须收成 1 条，否则并发请求的查询会串台（随机 500 / 返回错表数据）。
# 换成真 Postgres 时删掉这行或调大。
DATABASE_POOL_MAX=1
#
# 想用真 Postgres（Docker 或自建）时，把 DATABASE_URL 换成连接串，
# 并删掉或调大上面的 DATABASE_POOL_MAX（PGlite 必须保持 1）。然后：
#   docker compose up -d          # 自备 Postgres 可跳过
#   npm run db:generate && npm run db:migrate && npm run db:seed
#   npm run dev:external-db       # 不拉起 PGlite，直连 DATABASE_URL

# JWT 签名密钥。生产环境（NODE_ENV=production）下若仍是占位值或短于 32 位，服务会拒绝启动。
# 生成：openssl rand -base64 48
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# ── AI 网关（模型可插拔）──────────────────────────────
# 留空则使用内置规则引擎（mock）兜底，全链路仍可用
ANTHROPIC_API_KEY=""
# 默认模型；成本敏感场景可换 claude-haiku-4-5
ANTHROPIC_MODEL="claude-opus-4-8"
# 私有化/网关部署时覆盖（可选）
ANTHROPIC_BASE_URL=""
# auto | mock | anthropic（auto：有 key 用 LLM，否则 mock）
AI_PROVIDER="auto"

# 服务端口
PORT=3000

# 接口文档 /api/docs：非 production 默认开启；生产环境需显式设为 true 才挂载
# SWAGGER_ENABLED="true"

# 后台「完成签署」（模拟电子签回调）：生产环境默认禁用，合同须新员工本人在门户签署。
# 线下纸质签署后需在后台补录时才设为 true
# ESIGN_STAFF_SIGN="true"

# 跨域白名单（逗号分隔）。前端同源访问 /api 时无需设置；留空即不开启 CORS
# CORS_ORIGINS="https://admin.example.com"

# 反向代理可信跳数（Express trust proxy）。设置后 req.ip 才是真实客户端，登录限流会额外按 IP 计数。
# 本仓库的部署链路：nginx 一跳填 1；Render 等平台再加一层边缘代理填 2。不确定就留空（只按账号限流）
# TRUST_PROXY="1"

# ── 对象存储（S3 兼容，开发期对接 docker compose 里的 MinIO）────
# 全部可省略（代码内有与 compose 一致的默认值）；生产换云 OSS 只改这里
S3_ENDPOINT="http://localhost:9000"
# 容器化部署时浏览器可达的预签名端点（不设则与 S3_ENDPOINT 相同）
S3_PUBLIC_ENDPOINT=""
S3_ACCESS_KEY="arthr"
S3_SECRET_KEY="arthr_dev_password"
S3_BUCKET="arthr"
