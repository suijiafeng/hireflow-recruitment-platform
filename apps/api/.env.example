# 本地开发数据库：由 npm run dev 自动拉起的 PGlite（Postgres 18.3 编译成 WASM），
# 数据落在 apps/api/.pgdata，不需要 Docker、也不需要系统里装 Postgres。
# 端口用 5433 而不是 5432，避免和可能还开着的 docker compose 撞端口。
# PGlite 的 socket 服务不做鉴权，用户名密码填什么都能连；库名固定是 postgres。
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?schema=public"
# PGlite 是单会话后端：Prisma 连接池必须收成 1 条，否则并发请求的查询会串台（随机 500 / 返回错表数据）。
# 换成真 Postgres 时删掉这行或调大。
DATABASE_POOL_MAX=1
#
# 想用真 Postgres 也可以：
#   - Docker：npm run dev:docker（先 docker compose up -d，再迁移 + 种子 + 起服务），连接串换成
#     DATABASE_URL="postgresql://hireflow:hireflow_dev_password@127.0.0.1:5432/hireflow?schema=public"
#   - 自建库：把连接串换成你的，用 npm run dev:external-db
#   两种情况都把下面的 DATABASE_POOL_MAX 删掉或调大。

# JWT 签名密钥。生产环境（NODE_ENV=production）下若仍是占位值或短于 32 位，服务会拒绝启动。
# 生成：openssl rand -base64 48
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# ── AI 网关（模型可插拔）──────────────────────────────
# auto | mock | anthropic | openai
#   auto：有 ANTHROPIC_API_KEY 用 Anthropic；否则有 AI_API_KEY + AI_BASE_URL 用 OpenAI 兼容接口；都没有用规则引擎（mock）
AI_PROVIDER="auto"

# Anthropic（留空则不启用）
ANTHROPIC_API_KEY=""
# smart 档：简历解析、匹配评分、面评草稿、候选人对比（开自适应思考）
ANTHROPIC_MODEL="claude-opus-4-8"
# fast 档：JD 生成、漏斗诊断、入职问答（小模型、不开思考）
ANTHROPIC_MODEL_FAST="claude-haiku-4-5"
# 私有化/网关部署时覆盖（可选）
ANTHROPIC_BASE_URL=""

# OpenAI 兼容接口：DeepSeek / 通义千问 / Kimi / 智谱 / 本地 vLLM、Ollama 都填这一组
#   DeepSeek：AI_BASE_URL="https://api.deepseek.com/v1"  AI_MODEL="deepseek-chat"
#   通义千问：AI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"  AI_MODEL="qwen-plus"  AI_MODEL_FAST="qwen-turbo"
#   本地 vLLM：AI_BASE_URL="http://127.0.0.1:8000/v1"  AI_JSON_MODE="json_schema"
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
AI_MODEL_FAST=""
# json_object（DeepSeek/通义等通用，Schema 写进提示词）| json_schema（支持严格结构化输出的服务）
AI_JSON_MODE="json_object"
# 页面上显示的供应商名，默认按 AI_BASE_URL 推断（deepseek / qwen / openai-compatible …）
# AI_PROVIDER_LABEL=""

# 超时与并发：单次 HTTP 尝试超时、失败重试次数、整个能力调用（含排队）的截止时间、全局并发上限
# 前端 AI 请求超时 60s（人才库唤醒 100s），这里的截止时间必须小于它，否则会出现「前端报失败、后端其实成功」
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_DEADLINE_MS=40000
AI_MAX_CONCURRENCY=4
# 每个用户、每个 AI 接口每分钟最多调用次数
AI_RATE_LIMIT_PER_MIN=10
# 结果缓存有效期（小时，0 = 不过期）；缓存键已包含模型名与提示词版本
AI_CACHE_TTL_HOURS=168
# 用量面板的估算单价覆盖（美元/百万 token，按模型名前缀匹配），例：
# AI_PRICING_JSON='{"deepseek-chat":[0.28,0.42]}'

# ── AI Copilot（页头「Copilot」侧栏）────────────────────
# 与上面同一套模型配置；以下全部可省略，括号内为默认值
# COPILOT_PROVIDER=""            # 单独让 Copilot 用 mock（规则引擎），其余 AI 能力不受影响
# COPILOT_MODEL=""               # 覆盖模型名（默认 ANTHROPIC_MODEL_FAST / AI_MODEL）
# COPILOT_MAX_ITERATIONS=5       # 每轮最多「模型 → 工具 → 模型」迭代次数
# COPILOT_MAX_TOOL_CALLS=8       # 每轮最多工具调用次数
# COPILOT_TIMEOUT_MS=90000       # 单轮回复总时长上限
# COPILOT_MAX_OUTPUT_TOKENS=1500 # 单次模型调用输出上限
# COPILOT_TURN_MAX_COST_USD=0.1  # 单轮估算成本上限，超出后停止继续查询
# COPILOT_DAILY_TOKEN_BUDGET=400000  # 每人每日 token 预算
# COPILOT_RATE_PER_MIN=12        # 每人每分钟提问次数（另限同一账号同时只生成一条）
# COPILOT_HEARTBEAT_MS=15000     # SSE 心跳
# COPILOT_ACTION_TTL_MIN=30      # 待确认操作有效期
# COPILOT_HISTORY_LIMIT=30       # 带给模型的历史消息条数
# COPILOT_TIMEZONE="Asia/Shanghai"   # 面试时间展示时区
# COPILOT_MOCK_DELAY_MS=16       # 规则引擎流式输出的分片间隔

# 服务端口
PORT=3000

# 接口文档 /api/docs：非 production 默认开启；生产环境需显式设为 true 才挂载
# SWAGGER_ENABLED="true"

# 跨域白名单（逗号分隔）。前端同源访问 /api 时无需设置；留空即不开启 CORS
# CORS_ORIGINS="https://admin.example.com"

# 反向代理可信跳数（Express trust proxy）。设置后 req.ip 才是真实客户端，登录限流按「账号 + 来源 IP」渐进退避：
# 别人输错你的密码只会拖慢他自己，你从常用网络照常登录。生产强烈建议配置。
# 本仓库的部署链路：nginx 一跳填 1；Render 等平台再加一层边缘代理填 2。
# 留空时 IP 不可信，退化为按账号退避且最长只等 60 秒（不会被锁 15 分钟）
# TRUST_PROXY="1"

# ── 种子数据（npm run db:seed，部署时入口脚本自动执行，幂等）─────
# 基础数据：权限点 / 内置角色 + 首个管理员（库里还没有管理员时才创建）。
# ADMIN_PASSWORD 不填则随机生成，只在本次种子输出里打印一次。
# ADMIN_EMAIL="admin@your-company.com"
# ADMIN_PASSWORD=""
# 演示数据（演示账号 + 示例职位 / 候选人等）：非生产环境默认写入，设为 0 关闭；
# NODE_ENV=production 时无论如何都不会写演示数据。
# SEED_DEMO="1"

# 公司名称：Offer、劳动合同、候选人门户页头上显示
# COMPANY_NAME="HireFlow 科技有限公司"

# ── 文件存储（简历 / 合同）──────────────────────────────
# local：写本机目录（默认 apps/api/.storage），下载链接为 /api/files/<10 分钟签名令牌>，开发免装 MinIO；
# s3：MinIO / 云 OSS（S3 协议兼容）。不设 STORAGE_DRIVER 时：配了 S3_ENDPOINT 用 s3，否则用 local。
# 生产请用 s3——容器本地盘随实例重建而丢失。
STORAGE_DRIVER="local"
# STORAGE_LOCAL_DIR=".storage"
# 以下为 s3 驱动配置（npm run dev:docker 起的 MinIO 用这组默认值，同时把上面改成 STORAGE_DRIVER="s3"）
S3_ENDPOINT="http://localhost:9000"
# 容器化部署时浏览器可达的预签名端点（不设则与 S3_ENDPOINT 相同）
S3_PUBLIC_ENDPOINT=""
S3_ACCESS_KEY="hireflow"
S3_SECRET_KEY="hireflow_dev_password"
S3_BUCKET="hireflow"
