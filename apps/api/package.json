{
  "name": "@hireflow/api",
  "version": "0.1.0",
  "private": true,
  "description": "HireFlow 后端服务（NestJS）",
  "scripts": {
    "build": "node scripts/generate-client.mjs && nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "dev:wait": "tsx scripts/db.ts wait && nest start --watch",
    "db:setup": "tsx scripts/db.ts setup",
    "db:serve": "tsx scripts/db.ts serve",
    "db:reset": "tsx scripts/db.ts reset",
    "db:import": "tsx scripts/db.ts import",
    "db:generate": "node scripts/generate-client.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "node -e \"const fs=require('node:fs');const {spawnSync}=require('node:child_process');if(!fs.existsSync('scripts/generate-client.mjs'))process.exit(0);const r=spawnSync(process.execPath,['scripts/generate-client.mjs'],{stdio:'inherit'});process.exit(r.status==null?1:r.status)\"",
    "test": "node scripts/generate-client.mjs && jest",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/s3-request-presigner": "^3.1089.0",
    "@hireflow/shared": "*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pdf-parse": "^1.1.5",
    "dotenv": "^17.4.2",
    "jest": "^29.7.0",
    "prisma": "7.8.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json",
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "testEnvironment": "node"
  }
}
