// HireFlow 数据模型（枚举与 packages/shared/src/enums.ts 保持同步，schema 是事实来源）

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DataScope {
  ALL
  DEPARTMENT
  ASSIGNED
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  ACTIVE
  REJECTED
  WITHDRAWN
  HIRED
}

enum ResumeParseStatus {
  PENDING
  PARSING
  DONE
  FAILED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

/// 阶段类型：自动流转按类型定位阶段，阶段名可以随意改。四个系统阶段每个职位各一个、不可删除
enum StageKind {
  SCREENING // 筛选
  INTERVIEW // 面试（多轮面试是卡片上的轮次标签，不再拆列）
  OFFER // 录用
  ONBOARDING // 入职（接受 Offer 后进入；入职完成后状态为 HIRED，仍留在本列）
  CUSTOM // 职位自定义的普通阶段
}

/// Offer 由 HR 直接发出，不再经过审批；候选人答复记在 decision
enum OfferStatus {
  DRAFT // 迁移前尚未发出的 Offer，HR 确认后发送
  SENT
  EXPIRED // 到期未答复自动失效，可续期一次回到 SENT
}

enum OfferDecision {
  ACCEPTED
  DECLINED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/// 合同：接受 Offer 后自动生成，新员工在候选人页阅读并确认（输入姓名确认，记录时间）
enum ContractSignStatus {
  PENDING
  SIGNED
}

enum EvaluationConclusion {
  STRONG_YES
  YES
  NO
  STRONG_NO
}

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  passwordHash      String
  name              String
  status            UserStatus  @default(ACTIVE)
  /// 令牌版本：改密 / 重置密码 / 停用时 +1，签发时写进 JWT（tv），鉴权比对不一致即视为已吊销
  tokenVersion      Int         @default(0)
  passwordChangedAt DateTime?
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id])
  roles             UserRole[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  activityLogs      ActivityLog[]
  hiringManagerJobs Job[]                  @relation("JobHiringManager")
  createdJobs       Job[]                  @relation("JobCreatedBy")
  interviewSlots    InterviewInterviewer[]
  availableSlots    InterviewerSlot[]
  evaluations       Evaluation[]
  notifications     Notification[]
  copilotConversations CopilotConversation[]
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  dataScope   DataScope        @default(ASSIGNED)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  name  String
  group String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Department {
  id       String       @id @default(cuid())
  name     String
  parentId String?
  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children Department[] @relation("DeptTree")
  users    User[]
  jobs     Job[]
}

model Job {
  id                String          @id @default(cuid())
  title             String
  description       String?
  requirement       String?
  headcount         Int             @default(1)
  status            JobStatus       @default(DRAFT)
  departmentId      String
  department        Department      @relation(fields: [departmentId], references: [id])
  hiringManagerId   String?
  hiringManager     User?           @relation("JobHiringManager", fields: [hiringManagerId], references: [id])
  createdById       String
  createdBy         User            @relation("JobCreatedBy", fields: [createdById], references: [id])
  stages            PipelineStage[]
  applications      Application[]
  scorecardTemplate Json? // 岗位级评分卡模板 [{dimension, weight}]（空则用全局默认）
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([departmentId, status])
}

// 每个职位可自定义的招聘阶段（Pipeline Builder）
model PipelineStage {
  id           String        @id @default(cuid())
  jobId        String
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name         String
  kind         StageKind     @default(CUSTOM)
  order        Int
  applications Application[]

  @@index([jobId])
}

model Candidate {
  id           String        @id @default(cuid())
  name         String
  email        String?
  phone        String?
  source       String? // 来源渠道
  tags         String[] // AI/人工标签
  profile      Json? // 结构化画像扩展
  resumes      Resume[]
  applications Application[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([email])
  @@index([phone])
}

model Resume {
  id             String            @id @default(cuid())
  candidateId    String
  candidate      Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileKey        String? // 原件在对象存储中的 key
  fileName       String?
  rawText        String?
  parsed         Json? // AI 解析出的结构化字段
  skills         String[]
  parseStatus    ResumeParseStatus @default(PENDING)
  parseStartedAt DateTime? // 最近一次进入 PARSING 的时间：并发去重 + 进程中途挂掉后可超时重试
  createdAt      DateTime          @default(now())

  @@index([candidateId])
}

// 应聘记录：连接 Candidate 与 Job，驱动 Pipeline
model Application {
  id                 String            @id @default(cuid())
  candidateId        String
  candidate          Candidate         @relation(fields: [candidateId], references: [id])
  jobId              String
  job                Job               @relation(fields: [jobId], references: [id])
  stageId            String
  stage              PipelineStage     @relation(fields: [stageId], references: [id])
  status             ApplicationStatus @default(ACTIVE)
  matchScore         Int? // AI 匹配度分数
  matchReport        Json? // 打分依据
  matchSource        String? // 分数口径：ai = 大模型评分；rule = 规则引擎（未配模型或降级），列表/看板据此标注
  position           Float             @default(0) // 看板列内排序
  stageEnteredAt     DateTime          @default(now()) // 进入当前阶段时间（停留时长/SLA）
  version            Int               @default(0) // 乐观锁：并发拖卡冲突检测
  rejectReason       String? // 淘汰/撤回原因码（原因码强制）
  /// 候选人页令牌：一条应聘一个链接，选面试时间、答复 Offer、填写入职信息都在同一页
  portalToken        String?           @unique
  portalExpiresAt    DateTime? // 链接硬过期时间，每进入新的环节顺延
  interviews         Interview[]
  offer              Offer?
  onboarding         Onboarding?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([candidateId, jobId])
  @@index([jobId, stageId])
}

model Interview {
  id              String                 @id @default(cuid())
  applicationId   String
  application     Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  round           Int
  scheduledAt     DateTime?
  durationMins    Int?
  location        String?
  meetingUrl      String?
  status          InterviewStatus        @default(SCHEDULED)
  interviewers    InterviewInterviewer[]
  evaluations     Evaluation[]
  createdAt       DateTime               @default(now())

  @@index([applicationId])
}

// 面试官可约时段（无外部日历集成时的系统内空闲档）
model InterviewerSlot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  bookedBy  String? // 占用该时段的 interviewId；null = 空闲（落定时二次校验防冲突）
  createdAt DateTime @default(now())

  @@index([userId, startAt])
}

// AI 结果缓存（Token FinOps）：相同输入不重复调用引擎，命中即回放
model AiCache {
  id         String   @id @default(cuid())
  capability String // parseResume / scoreMatch …
  hash       String // sha256(规范化输入)
  payload    Json
  provider   String
  createdAt  DateTime @default(now())

  @@unique([capability, hash])
}

// AI 调用日志：每次能力调用一行（含缓存命中与降级），用于用量 / 成本 / 延迟面板
model AiCallLog {
  id           String   @id @default(cuid())
  capability   String // parseResume / scoreMatch …
  provider     String // anthropic / deepseek / qwen / mock …
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float? // 估算成本，未知模型为空
  latencyMs    Int
  cached       Boolean  @default(false)
  degraded     Boolean  @default(false)
  error        String?
  /// 发起调用的内部用户（Copilot 对话按人记账；后台批量任务为空）
  userId       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([capability, createdAt])
  @@index([userId, createdAt])
}

model InterviewInterviewer {
  interviewId String
  userId      String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([interviewId, userId])
}

model Evaluation {
  id            String                @id @default(cuid())
  interviewId   String
  interview     Interview             @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerId String
  interviewer   User                  @relation(fields: [interviewerId], references: [id])
  scorecard     Json? // 结构化评分卡：[{dimension, score, comment}]
  conclusion    EvaluationConclusion?
  comments      String?
  submittedAt   DateTime?
  createdAt     DateTime              @default(now())

  @@unique([interviewId, interviewerId])
  @@index([interviewerId])
}

model Offer {
  id              String              @id @default(cuid())
  applicationId   String              @unique
  application     Application         @relation(fields: [applicationId], references: [id])
  salary          Json? // 敏感字段：薪资结构（RBAC salary:view 控制）
  grade           String?
  startDate       DateTime?           @db.Date // 预计入职日期（进合同与候选人页）
  status          OfferStatus         @default(SENT)
  sentAt          DateTime?
  expiresAt       DateTime? // 答复截止（发送时 +5 个工作日）
  extendedOnce    Boolean             @default(false) // 有效期仅可续期一次
  respondedAt     DateTime?
  decision        OfferDecision?
  decisionReason  String? // 候选人拒绝原因码
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Onboarding {
  id              String           @id @default(cuid())
  applicationId   String           @unique
  application     Application      @relation(fields: [applicationId], references: [id])
  /// 新员工在候选人页填写的入职信息（证件号、银行卡、紧急联系人等），HR 以外只看尾号
  info            Json?
  infoSubmittedAt DateTime?
  status          OnboardingStatus @default(NOT_STARTED)
  completedAt     DateTime?
  contract        Contract?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Contract {
  id           String             @id @default(cuid())
  onboardingId String             @unique
  onboarding   Onboarding         @relation(fields: [onboardingId], references: [id])
  templateName String?
  variables    Json? // 模板变量填充值
  signStatus   ContractSignStatus @default(PENDING)
  signedAt     DateTime?
  signerName   String? // 新员工确认时输入的姓名
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

// 公司制度文档：候选人页入职问答与 Copilot「查制度」的知识库
model CompanyDoc {
  id        String   @id @default(cuid())
  title     String
  content   String
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 站内通知
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String? // 前端路由，点击跳转
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// 全流程操作日志：360° 时间轴 + 合规审计
model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorName  String? // 冗余存储：候选人/系统触发时无内部用户
  action     String // 约定见 shared ACTIVITY_ACTIONS，如 application.stage_changed
  entityType String // 取值如 Job / Candidate / Application / Interview
  entityId   String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([entityId])
  @@index([createdAt])
  @@index([action, createdAt])
}

enum CopilotActionStatus {
  PENDING // 等待用户确认
  EXECUTING // 已认领，正在执行（防重复确认）
  EXECUTED
  REJECTED // 用户取消
  FAILED // 执行时权限 / 乐观锁 / 业务校验未通过
  EXPIRED
}

/// AI Copilot 对话：只属于发起人本人；context 记录从哪个页面打开（候选人 / 职位），用于预置上下文
model CopilotConversation {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  contextType String? // candidate / job
  contextId   String?
  messages    CopilotMessage[]
  actions     CopilotAction[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, updatedAt])
}

/// 对话消息：user / assistant（可带 toolCalls）/ tool（工具结果，已脱敏、不可信内容已装箱）
model CopilotMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user / assistant / tool
  content        String              @default("")
  toolCalls      Json? // assistant：[{ id, name, args }]
  toolCallId     String? // tool：对应的调用 id
  toolName       String?
  meta           Json? // assistant：provider / degraded / aborted / usage；tool：label / summary / ok
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

/// 写操作提案：模型只能「提议」，由用户在界面上确认后才执行；执行时重新校验权限与乐观锁
model CopilotAction {
  id             String              @id @default(cuid())
  conversationId String
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  messageId      String? // 发起提案的 assistant 消息
  toolCallId     String?
  tool           String
  args           Json // 归一化后的执行参数（已解析 id、记下 expectedVersion）
  summary        String
  preview        Json? // 确认卡片展示字段
  danger         Boolean             @default(false)
  status         CopilotActionStatus @default(PENDING)
  result         Json?
  error          String?
  expiresAt      DateTime
  decidedAt      DateTime?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@index([userId, status])
}
